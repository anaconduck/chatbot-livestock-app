# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TanyaTernak"

# Demo Mode (Allows fully functional UI & role testing without Supabase credentials)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Credentials for real Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Free AI Chatbot (Opsional - Gratis tanpa Dify)
# Kosongkan untuk langsung menggunakan mode pencarian internet otomatis gratis,
# atau isi salah satu kunci gratis di bawah ini:
# - Google AI Studio (Gratis 1.500 req/hari + Google Search): https://aistudio.google.com/apikey
# - Groq Cloud (Gratis Llama 3.3 70B): https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
