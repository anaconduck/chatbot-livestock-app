# Dify AI Integration (Future / Stubs)
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CHAT_API_KEY=app-placeholder-dify-chat-key
DIFY_KNOWLEDGE_API_KEY=dataset-placeholder-dify-key
